@model TPRedSocial.Models.Publicaciones

@{
    ViewData["Title"] = "Crear Publicación";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Crear publicación</h3>
                </div>
                <div class="card-body p-4">
                    <form action="@Url.Action("PostCrearPublicacion", "Home")" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="imagen" class="form-label">Imagen</label>
                            <input type="file" class="form-control" id="imagen" name="imagen" accept="image/*" required>
                        </div>

                        <div class="mb-3">
                            <label for="titulo" class="form-label">Título</label>
                            <input type="text" class="form-control" id="titulo" name="titulo" asp-for="Titulo" required>
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label">Descripción</label>
                            <textarea class="form-control" id="descripcion" name="descripcion" asp-for="Descripcion" rows="4" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Publicar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
