@model List<Publicaciones>

@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/publicaciones.css" />
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Botón Crear Publicación -->
            <div class="mb-4 text-center">
                <a href="@Url.Action("CrearPublicacion", "Home")" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus"></i> Crear publicación
                </a>
            </div>

            <!-- Feed de Publicaciones -->
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var publicacion in Model)
                {
                    <div class="card mb-4 shadow-sm publicacion-card" data-publicacion-id="@publicacion.Id" style="border: 1px solid #e1e8ed;">
                        <!-- Encabezado con info del usuario -->
                        <div class="card-header bg-white border-bottom" style="padding: 12px 16px;">
                            <div class="d-flex align-items-center">
                                <div style="width: 40px; height: 40px; border-radius: 50%; background-color: #e1e8ed; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                                    <span style="font-weight: 600; color: #0f1419;">@publicacion.Nombre.FirstOrDefault()</span>
                                </div>
                                <div>
                                    <div style="font-weight: 600; color: #0f1419;">
                                        @publicacion.Nombre @publicacion.Apellido
                                    </div>
                                    <div style="font-size: 13px; color: #536471;">
                                        @@publicacion.NombreUsuario
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Imagen de la publicación -->
                        @if (!string.IsNullOrEmpty(publicacion.Imagen))
                        {
                            <img src="/imagenes/@publicacion.Imagen" class="card-img-top" alt="Publicación" style="max-height: 500px; object-fit: cover;">
                        }

                        <!-- Contenido de la publicación -->
                        <div class="card-body" style="padding: 12px 16px;">
                            <!-- Botones de interacción -->
                            <div class="mb-3" style="display: flex; gap: 16px; font-size: 20px;">
                                <button class="btn btn-link p-0 btn-like" data-publicacion-id="@publicacion.Id" style="color: #0f1419; text-decoration: none; border: none; background: none; cursor: pointer;">
                                    <i class="far fa-heart"></i>
                                </button>
                                <button class="btn btn-link p-0 btn-comentario" data-publicacion-id="@publicacion.Id" style="color: #0f1419; text-decoration: none; border: none; background: none; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#modalComentarios@publicacion.Id">
                                    <i class="far fa-comment"></i>
                                </button>
                                <button class="btn btn-link p-0" style="color: #0f1419; text-decoration: none; border: none; background: none; cursor: pointer;">
                                    <i class="far fa-share"></i>
                                </button>
                            </div>

                            <!-- Contador de likes -->
                            <div class="mb-2">
                                <small style="color: #0f1419; font-weight: 600;">
                                    <span class="likes-count-@publicacion.Id">0</span> Me gusta
                                </small>
                            </div>

                            <!-- Título -->
                            <h5 class="card-title" style="color: #0f1419; margin-bottom: 8px;">
                                @publicacion.Titulo
                            </h5>

                            <!-- Descripción -->
                            <p class="card-text" style="color: #536471; margin-bottom: 8px;">
                                @publicacion.Descripcion
                            </p>

                            <!-- Fecha -->
                            <small style="color: #536471;">
                                @publicacion.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                            </small>

                            <!-- Sección de comentarios -->
                            <div class="mt-3 border-top pt-3">
                                <div id="comentarios-@publicacion.Id" class="comentarios-container" style="max-height: 200px; overflow-y: auto; margin-bottom: 10px;">
                                    <!-- Los comentarios se cargarán aquí con JavaScript -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal para comentarios -->
                    <div class="modal fade" id="modalComentarios@publicacion.Id" tabindex="-1" aria-labelledby="modalLabel@publicacion.Id" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalLabel@publicacion.Id">Comentarios</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div id="comentarios-modal-@publicacion.Id" class="comentarios-modal" style="max-height: 300px; overflow-y: auto; margin-bottom: 15px;">
                                        <!-- Los comentarios se cargarán aquí -->
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <form class="form-comentario" data-publicacion-id="@publicacion.Id" style="width: 100%;">
                                        <div class="input-group">
                                            <input type="text" class="form-control texto-comentario" placeholder="Escribe un comentario..." style="font-size: 14px;">
                                            <button class="btn btn-primary" type="submit">Publicar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info text-center" role="alert">
                    <h5>No hay publicaciones aún</h5>
                    <p>¡Sé el primero en crear una publicación!</p>
                    <a href="@Url.Action("CrearPublicacion", "Home")" class="btn btn-primary">
                        Crear Publicación
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/publicaciones.js"></script>
}