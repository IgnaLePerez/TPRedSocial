@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Botón Crear Publicación -->
            <div class="mb-4 text-center">
                <a href="@Url.Action("CrearPublicacion", "Home")" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus"></i> Crear publicación
                </a>
            </div>

            <!-- Feed de Publicaciones -->
            @if (ViewBag.publicaciones != null && ViewBag.publicaciones.Count > 0)
            {
                @foreach (var publicacion in ViewBag.publicaciones)
                {
                    <div class="card mb-4 shadow-sm publicacion-card" data-publicacion-id="@publicacion.Id">
                        <!-- Encabezado con info del usuario -->
                        <div class="card-header bg-white border-bottom">
                            <div class="d-flex align-items-center">
                                <div class="avatar-placeholder">
                                    <span class="avatar-initial">@publicacion.Nombre</span>
                                </div>
                                <div>
                                    <div class="user-name">
                                        @publicacion.Nombre @publicacion.Apellido
                                    </div>
                                    <div class="user-meta">
                                        @publicacion.NombreUsuario
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Imagen de la publicación -->
                        <img src="/imagenes/@publicacion.Imagen" class="card-img-top publicacion-img" alt="Publicación">

                        <!-- Contenido de la publicación -->
                        <div class="card-body">
                            <!-- Botones de interacción -->
                            <div class="mb-3 publicacion-actions">
                                <button class="btn btn-link p-0 btn-like icon-btn" onclick="DarLike(@publicacion.Id)">
                                    <i class="far fa-heart"></i>
                                </button>
                                <button class="btn btn-link p-0 btn-comentario icon-btn" data-publicacion-id="@publicacion.Id" data-bs-toggle="modal" data-bs-target="#modalComentarios@publicacion.Id">
                                    <i class="far fa-comment"></i>
                                </button>
                                <button class="btn btn-link p-0 icon-btn">
                                    <i class="far fa-share"></i>
                                </button>
                            </div>

                            <!-- Contador de likes -->
                            <div class="mb-2">
                                <small class="likes-small">
                                    <span class="likes-count-@publicacion.Id" id="contadorLikes">0</span> Me gusta
                                </small>
                            </div>

                            <!-- Título -->
                            <h5 class="card-title publicacion-title">
                                @publicacion.Titulo
                            </h5>

                            <!-- Descripción -->
                            <p class="card-text publicacion-text">
                                @publicacion.Descripcion
                            </p>

                            <!-- Fecha -->
                            <small class="publicacion-date">
                                @publicacion.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                            </small>

                            <!-- Sección de comentarios -->
                            <div class="mt-3 border-top pt-3">
                                <div id="comentarios-@publicacion.Id" class="comentarios-container">
                                    <!-- Los comentarios se cargarán aquí con JavaScript -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal para comentarios -->
                    <div class="modal fade" id="modalComentarios@publicacion.Id" tabindex="-1" aria-labelledby="modalLabel@publicacion.Id" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalLabel@publicacion.Id">Comentarios</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div id="comentarios-modal-@publicacion.Id" class="comentarios-modal">
                                        <!-- Los comentarios se cargarán aquí -->
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <form class="form-comentario" data-publicacion-id="@publicacion.Id">
                                        <div class="input-group">
                                            <input type="text" class="form-control texto-comentario" placeholder="Escribe un comentario...">
                                            <button class="btn btn-primary" type="submit">Publicar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info text-center" role="alert">
                    <h5>No hay publicaciones aún</h5>
                    <p>¡Sé el primero en crear una publicación!</p>
                    <a href="@Url.Action("CrearPublicacion", "Home")" class="btn btn-primary">
                        Crear Publicación
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
}